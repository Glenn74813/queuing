# ---- Native (non-Docker) node environment ----
# Installed as /etc/philhealth-qms/qms.env (owner root:qms, mode 600) by install-native.sh.
# Read by the qms-api systemd unit (EnvironmentFile=) and by install/backup/restore scripts.
# Never commit a filled-in copy. Values must not be quoted; systemd takes everything after '='.
#
# Same variables as deploy/env/site.env.example, plus the native-only block at the end.
# For a central node set QMS_NODE_ROLE=CENTRAL, leave QMS_SITE_CODE empty and QMS_SYNC_ENABLED=false
# (see deploy/env/central.env.example for the central defaults, e.g. QMS_DB_POOL_SIZE=40).

QMS_VERSION=0.1.0
QMS_NODE_ROLE=SITE
# The LHIO / office code configured centrally (required when QMS_NODE_ROLE=SITE)
QMS_SITE_CODE=
QMS_TIMEZONE=Asia/Manila

# Database: owner (migrations/admin) and least-privilege application account
QMS_DB_OWNER=qms_owner
QMS_DB_OWNER_PASSWORD=
QMS_DB_USER=qms_app
QMS_DB_PASSWORD=
QMS_DB_POOL_SIZE=20

# Security
# QMS_JWT_SECRET: generate with  openssl rand -base64 48
QMS_JWT_SECRET=
QMS_ACCESS_TOKEN_MINUTES=15
QMS_REFRESH_TOKEN_HOURS=12
QMS_CORS_ORIGINS=https://qms-site.example.philhealth.gov.ph
# Only for the first start; remove afterwards and restart qms-api
QMS_BOOTSTRAP_ADMIN_PASSWORD=
QMS_API_DOCS_ENABLED=false

# Synchronization with the central node
QMS_SYNC_ENABLED=true
QMS_CENTRAL_URL=https://qms-central.example.philhealth.gov.ph
# Issued on central: POST /api/v1/sites/{id}/sync-key
QMS_SYNC_SITE_KEY=

# ---- Native-only settings (Docker Compose sets these itself) ----
# The application listens on 127.0.0.1:8080 behind nginx; PostgreSQL runs on the same host.
QMS_DB_URL=jdbc:postgresql://127.0.0.1:5432/qms
# Flyway migrations run as the schema owner; keep these equal to QMS_DB_OWNER / QMS_DB_OWNER_PASSWORD.
# The application itself connects as QMS_DB_USER (DML only, granted by migration V3).
SPRING_FLYWAY_USER=qms_owner
SPRING_FLYWAY_PASSWORD=
QMS_MEDIA_DIR=/opt/philhealth-qms/data/media
# Generated scheduled reports (regenerable; kept QMS_REPORTS_RETENTION_DAYS days, default 180)
QMS_REPORTS_DIR=/opt/philhealth-qms/data/reports
# Bind the API to loopback only; nginx is the only client.
SERVER_ADDRESS=127.0.0.1
JAVA_OPTS=-XX:MaxRAMPercentage=70 -Duser.timezone=UTC
