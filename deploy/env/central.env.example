# ---- Central node environment (copy to central.env, chmod 600, never commit the copy) ----
QMS_VERSION=0.1.0
QMS_NODE_ROLE=CENTRAL
QMS_TIMEZONE=Asia/Manila
QMS_DB_OWNER=qms_owner
QMS_DB_OWNER_PASSWORD=
QMS_DB_USER=qms_app
QMS_DB_PASSWORD=
# Docker Compose sets SPRING_FLYWAY_USER/PASSWORD from QMS_DB_OWNER*. For a non-Docker install, set them
# here so that migrations run as the schema owner and the application keeps DML-only rights.
QMS_DB_POOL_SIZE=40
QMS_JWT_SECRET=
QMS_CORS_ORIGINS=https://qms-central.example.philhealth.gov.ph
QMS_BOOTSTRAP_ADMIN_PASSWORD=
QMS_API_DOCS_ENABLED=false
QMS_SYNC_ENABLED=false
