# ---- Site node environment (copy to site.env, chmod 600, never commit the copy) ----
QMS_VERSION=0.1.0
QMS_NODE_ROLE=SITE
QMS_SITE_CODE=                     # e.g. the LHIO code configured centrally
QMS_TIMEZONE=Asia/Manila

# Database: owner (migrations/admin) and least-privilege application account
QMS_DB_OWNER=qms_owner
QMS_DB_OWNER_PASSWORD=
QMS_DB_USER=qms_app
QMS_DB_PASSWORD=
# Docker Compose sets SPRING_FLYWAY_USER/PASSWORD from QMS_DB_OWNER*. For a non-Docker install, set them
# here so that migrations run as the schema owner and the application keeps DML-only rights.

# Security
QMS_JWT_SECRET=                    # openssl rand -base64 48
QMS_ACCESS_TOKEN_MINUTES=15
QMS_REFRESH_TOKEN_HOURS=12
QMS_CORS_ORIGINS=https://qms-site.example.philhealth.gov.ph
QMS_BOOTSTRAP_ADMIN_PASSWORD=      # only for first start; remove afterwards
QMS_API_DOCS_ENABLED=false

# Synchronization with the central node
QMS_SYNC_ENABLED=true
QMS_CENTRAL_URL=https://qms-central.example.philhealth.gov.ph
QMS_SYNC_SITE_KEY=                 # issued on central: POST /api/v1/sites/{id}/sync-key
