# Base URL of the QMS REST API. Relative by default so the app works behind the same reverse proxy.
VITE_API_BASE_URL=/api/v1
# Agency name shown in the header placeholder "logo" area (no official logos are bundled).
VITE_AGENCY_NAME=PhilHealth
# Logo file under public/ (served from the site root); the PhilHealth logo is bundled at branding/logo.svg
VITE_AGENCY_LOGO=/branding/logo.svg
